# Harness Environment Configuration Template
# Copy this file to '.env' and fill in your private local settings.

# Default Model Selection for Harness CLI & Sub-Agents
HARNESS_MODEL=gemini-3.6-flash

# SQLite Database Path (Optional override)
HARNESS_DB=./harness.db

# JEV Decision Model Settings (Primary: Server nội bộ qua Tailscale)
HARNESS_JEV_ENDPOINT=http://100.124.36.46:20128/v1/systemone
HARNESS_JEV_API_KEY=your_jev_api_key_here
HARNESS_JEV_MODEL=oc/jev-1.13-free

# JEV Fallback Settings (Local MLX Apple Silicon nếu primary nghẽn pool)
HARNESS_JEV_FALLBACK_ENDPOINT=http://127.0.0.1:8009/v1/systemone
HARNESS_JEV_FALLBACK_MODEL=jaredpalmer/kev-0.8b

# Concurrency & Policy Tuning
HARNESS_JEV_CONFIDENCE_THRESHOLD=0.60
HARNESS_JEV_MAX_CONCURRENT=1
HARNESS_JEV_RATE_LIMIT_MS=200
